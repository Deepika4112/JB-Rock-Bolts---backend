APP_NAME=JB Rock Bolts API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True
PORT=8000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jbrockbolts_db
DB_USER=root
DB_PASSWORD=

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173

# Security
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ── Cloudflare R2 (File Storage) ──────────────────────────────────────────────
# Get these from Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=jb-rock-bolts
# Either the R2.dev public URL or your custom domain
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
